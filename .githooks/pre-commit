#!/usr/bin/env bash
# Tasty pre-commit hook — 빠른 검사 7종.
#
# 설치: `git config core.hooksPath .githooks` 1회 실행.
# bypass: `git commit --no-verify` (긴급 시).
#
# 정책: 모든 *diff 기반* 검사 (C.6/C.9/C.11/C.12) 는 **staged diff 의 추가 라인
# (`+`) 만** 본다. 기존 코드의 위반은 잡지 않는다 — 신규 추가에만 적용
# (changed-only policy). A.1/A.2 만 *파일 전체* 검사 (포맷·선언 순서는 컨텍스트
# 전체가 필요).
#
# 검사 목록:
#   A.1  mod/use 선언 순서 (mod 다 먼저, use 다 나중)  [파일 전체]
#   A.2  cargo fmt --check                              [파일 전체]
#   C.6  `let _ =` 주석 강제                            [diff 추가 라인]
#   C.8  UI 색상 하드코딩 — clippy 로 이관 (비활성)
#   C.9  egui::Window 직접 사용                          [diff 추가 라인]
#   C.11 println! / eprintln! — tracing 강제             [diff 추가 라인]
#   C.12 dbg! — debug leak 방지                          [diff 추가 라인]
#
# 무거운 검사 (cargo clippy, cargo check) 는 pre-push 에서.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# staged 된 .rs 파일 목록
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)

red()    { printf '\033[31m%s\033[0m\n' "$*" >&2; }
yellow() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }

FAIL=0
fail() { red "  ✘ $*"; FAIL=1; }

# ────────────────────────────────────────────────────────────
# A.1  mod/use 선언 순서
# ────────────────────────────────────────────────────────────
check_mod_use_order() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        # top-level "선언 영역" 안에서만 검사. 영역 = 빈 줄/주석/attribute/use/mod/
        # extern crate 만 나오는 동안. 첫 코드 토큰 (fn/struct/impl/const/static/
        # type/trait/enum/macro_rules) 이 나오면 영역 종료 — dispatcher 패턴
        # (use → fn → 하단 mod tests) 은 정당하므로 통과.
        local violation
        violation=$(awk '
            /^[[:space:]]/ { next }
            /^\/\// { next }
            /^$/ { next }
            /^#\[/ { next }
            /^#!\[/ { next }
            /^(pub(\([^)]*\))?[[:space:]]+)?use[[:space:]]/ { if (!end_zone) saw_use = NR; next }
            /^(pub(\([^)]*\))?[[:space:]]+)?extern[[:space:]]+crate[[:space:]]/ { next }
            /^(pub(\([^)]*\))?[[:space:]]+)?mod[[:space:]]/ {
                if (saw_use && !end_zone) { print NR; exit }
                next
            }
            { end_zone = 1 }
        ' "$f")
        if [ -n "$violation" ]; then
            fail "[A.1 mod/use 순서] $f:$violation — 선언 영역에서 mod 가 use 뒤에 나옴"
        fi
    done
}

# ────────────────────────────────────────────────────────────
# A.2  cargo fmt --check
# ────────────────────────────────────────────────────────────
check_cargo_fmt() {
    if [ -z "$STAGED_RS" ]; then return; fi
    if ! cargo fmt --check 2>/dev/null; then
        fail "[A.2 cargo fmt] 포맷 위반. \`cargo fmt\` 실행 후 다시 staging."
    fi
}

# ────────────────────────────────────────────────────────────
# C.6  `let _ =` 주석 강제
# ────────────────────────────────────────────────────────────
# staged diff 의 추가 line 만 검사. "의도 명시" 로 인정하는 조건 (OR):
#   ① 같은 줄에 // 주석이 있음, 또는
#   ② 직전 라인 (새 파일 기준 바로 앞 라인 — 추가/컨텍스트 무관) 이 // 주석.
# docs/dev-guide/error-handling.md 의 윗줄 주석 관례 + 멀티라인 write! 케이스를
# 인정한다. 주석이 전혀 없는 `let _ =` 는 여전히 거부.
# -U1 로 직전 라인 컨텍스트를 확보하고 awk 로 "let 라인 + 직전 라인" 을 함께 본다.
check_let_underscore() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        local violation
        violation=$(git diff --cached -U1 -- "$f" | awk '
            /^@@/     { prev = ""; next }   # hunk 경계: 직전 라인 컨텍스트 리셋
            /^\+\+\+/ { next }              # +++ b/file 헤더
            /^---/    { next }              # --- a/file 헤더
            {
                prefix  = substr($0, 1, 1)
                content = substr($0, 2)
                if (prefix == "-") next     # 제거 라인: 새 파일에 없음 → 무시
                if (prefix == "+" || prefix == " ") {
                    if (prefix == "+" && content ~ /let[[:space:]]+_[[:space:]]*=/) {
                        if (content ~ /\/\//) {
                            # ① 같은 줄 주석 — OK
                        } else if (prev ~ /^[[:space:]]*\/\//) {
                            # ② 윗줄 주석 — OK
                        } else {
                            print content
                        }
                    }
                    prev = content          # 새 파일에 존재하는 라인만 직전으로 갱신
                }
            }
        ')
        if [ -n "$violation" ]; then
            fail "[C.6 let _] $f — 주석 없는 \`let _ =\` 추가됨 (왜 무시하는지 주석 필요):"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ────────────────────────────────────────────────────────────
# C.8  UI 색상 하드코딩 — clippy::disallowed_methods 로 대체됨
# ────────────────────────────────────────────────────────────
# clippy.toml 의 disallowed-methods 가 정확히 같은 검사를 #[allow] 인식 + path
# resolution 포함해 수행한다. grep 기반 검사는 우리 의도된 외부 입력 사이트
# (settings 픽커, 이미지 픽셀 추출 등) 의 #[allow] 도 잡아 false positive 가 많음.
# pre-push 에서 cargo clippy 가 돈다 — 무거운 색 검사는 거기서 처리.
check_color_hardcode() {
    return 0
}

# ────────────────────────────────────────────────────────────
# C.9  egui::Window 직접 사용 (PopupManager 강제)
# ────────────────────────────────────────────────────────────
# staged diff 의 추가 line 만 검사.
check_egui_window() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        case "$f" in
            src/ui/popup/*) continue ;;
            src/ui/popup_defs.rs) continue ;;
        esac
        local violation
        violation=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -v '^+++' \
            | grep -E 'egui::Window::|egui::Window[[:space:]]*<' \
            || true)
        if [ -n "$violation" ]; then
            fail "[C.9 egui::Window] $f — PopupManager/PopupDef 시스템 사용 (docs/dev-guide/popup-implementation.md):"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ────────────────────────────────────────────────────────────
# C.11 println! / eprintln! (tracing 강제)
# ────────────────────────────────────────────────────────────
# 정책: staged diff 의 추가 라인만 검사 (changed-only).
# 예외 path — *CLI 응답 출력* 은 println 정당:
#   - src/main.rs                     : boot 진입점
#   - src/boot/cli_routing.rs         : clap 라우팅 (잠재적 println)
#   - crates/tasty-cli/*              : CLI 응답 출력 (tree, JSON, 에러 메시지 등
#                                       — caller 가 stdout/stderr 로 수신)
#   - crates/tasty-tui-simulator/*    : 테스트용 TUI simulator
#   - **/build.rs                     : cargo build script — `cargo:warning=` /
#                                       `cargo:rerun-if-changed=` 같은 directive 가
#                                       println 으로만 가능 (build.rs 에선 tracing
#                                       사용 불가)
# 그 외 .rs 파일은 tracing::info!/warn!/error! 사용.
check_println() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        case "$f" in
            src/main.rs) continue ;;
            src/boot/cli_routing.rs) continue ;;
            crates/tasty-cli/*) continue ;;
            crates/tasty-tui-simulator/*) continue ;;
            build.rs) continue ;;
            */build.rs) continue ;;
        esac
        local violation
        violation=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -v '^+++' \
            | grep -E '\b(println|eprintln)!' \
            | grep -vE '^\+[[:space:]]*//' \
            || true)
        if [ -n "$violation" ]; then
            fail "[C.11 println] $f — \`tracing::info!\` / \`tracing::warn!\` 등 사용:"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ────────────────────────────────────────────────────────────
# C.12 dbg! 매크로 (debug leak 방지)
# ────────────────────────────────────────────────────────────
# staged diff 의 추가 line 만 검사.
check_dbg() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        local violation
        violation=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -v '^+++' \
            | grep -E '\bdbg!' \
            | grep -vE '^\+[[:space:]]*//' \
            || true)
        if [ -n "$violation" ]; then
            fail "[C.12 dbg!] $f — \`dbg!\` 매크로 추가됨 (release 에 leak 금지):"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ────────────────────────────────────────────────────────────
# 실행
# ────────────────────────────────────────────────────────────
check_mod_use_order
check_cargo_fmt
check_let_underscore
check_color_hardcode
check_egui_window
check_println
check_dbg

if [ "$FAIL" -ne 0 ]; then
    echo >&2
    red "✘ pre-commit 검사 실패. 위 항목을 수정하거나 \`git commit --no-verify\` 로 우회."
    exit 1
fi

green "✓ pre-commit 검사 통과"
exit 0
