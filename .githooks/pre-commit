#!/usr/bin/env bash
# Tasty pre-commit hook — 빠른 검사 7종.
#
# 설치: `git config core.hooksPath .githooks` 1회 실행.
# bypass: `git commit --no-verify` (긴급 시).
#
# 정책: 모든 *diff 기반* 검사 (C.6/C.9/C.11/C.12) 는 **staged diff 의 추가 라인
# (`+`) 만** 본다. 기존 코드의 위반은 잡지 않는다 — 신규 추가에만 적용
# (changed-only policy). A.1/A.2 만 *파일 전체* 검사 (포맷·선언 순서는 컨텍스트
# 전체가 필요).
#
# 검사 목록:
#   A.1  mod/use 선언 순서 (mod 다 먼저, use 다 나중)  [파일 전체]
#   A.2  cargo fmt --check (+ workspace exclude 크레이트는 manifest 별도) [파일 전체]
#   C.6  `let _ =` 주석 강제                            [diff 추가 라인]
#   C.8  UI 색상 하드코딩 — clippy 로 이관 (비활성)
#   C.9  egui::Window 직접 사용                          [diff 추가 라인]
#   C.11 println! / eprintln! — tracing 강제             [diff 추가 라인]
#   C.12 dbg! — debug leak 방지                          [diff 추가 라인]
#   P.1  plugin 산출물이 바뀌었는데 매니페스트 version 이 그대로 [staged diff]
#   W.1  사용자 표면 변경 시 CHANGELOG 누락 (경고만)     [staged 파일 목록]
#
# 무거운 검사 (cargo clippy, cargo check) 는 pre-push 에서.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# staged 된 .rs 파일 목록
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)

red()    { printf '\033[31m%s\033[0m\n' "$*" >&2; }
yellow() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }

# ────────────────────────────────────────────────────────────
# M.1  merge 커밋 차단 — branch 가 갈라지는 2-parent 머지 커밋 금지.
#      pre-merge-commit 은 clean non-ff merge 만 잡는다. **충돌 merge** 는
#      git merge 가 커밋을 안 만들고 멈춘 뒤 resolve → `git commit` 으로
#      마무리되며, 그 커밋은 pre-merge-commit 이 아니라 이 훅을 탄다.
#      여기서 잡지 않으면 충돌 merge 가 갈래 커밋으로 새어 들어온다.
#      정책: 모든 통합은 rebase → ff-merge 로 선형 유지. rebase 로 다 된다.
# ────────────────────────────────────────────────────────────
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    red "✘ branch 가 갈라지는 merge 커밋이 차단되었습니다 (2-parent)."
    echo
    yellow "▸ 정책: 모든 통합은 rebase 로 선형화한다. 충돌이 있어도 rebase 로 해결된다 —"
    yellow "  merge 커밋(갈래)은 만들지 않는다."
    echo
    yellow "▸ 지금 이 merge 를 되돌리고 rebase 로 재시도하라:"
    yellow "    git merge --abort"
    yellow "    git rebase <대상-브랜치>       # 충돌나면 양쪽 의도를 확인 후 해결"
    yellow "    git merge --ff-only <브랜치>"
    echo
    yellow "▸ 충돌은 '마커만 지워서' 해결하지 마라 — 양쪽 변경의 의도를 파악하고"
    yellow "  맞는 결과로 합쳐라. 애매하면 rebase --abort 후 원인부터 분석하라."
    echo
    exit 1
fi

FAIL=0
fail() { red "  ✘ $*"; FAIL=1; }

# ────────────────────────────────────────────────────────────
# A.1  mod/use 선언 순서
# ────────────────────────────────────────────────────────────
check_mod_use_order() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        # top-level "선언 영역" 안에서만 검사. 영역 = 빈 줄/주석/attribute/use/mod/
        # extern crate 만 나오는 동안. 첫 코드 토큰 (fn/struct/impl/const/static/
        # type/trait/enum/macro_rules) 이 나오면 영역 종료 — dispatcher 패턴
        # (use → fn → 하단 mod tests) 은 정당하므로 통과.
        local violation
        violation=$(awk '
            /^[[:space:]]/ { next }
            /^\/\// { next }
            /^$/ { next }
            /^#\[/ { next }
            /^#!\[/ { next }
            /^(pub(\([^)]*\))?[[:space:]]+)?use[[:space:]]/ { if (!end_zone) saw_use = NR; next }
            /^(pub(\([^)]*\))?[[:space:]]+)?extern[[:space:]]+crate[[:space:]]/ { next }
            /^(pub(\([^)]*\))?[[:space:]]+)?mod[[:space:]]/ {
                if (saw_use && !end_zone) { print NR; exit }
                next
            }
            { end_zone = 1 }
        ' "$f")
        if [ -n "$violation" ]; then
            fail "[A.1 mod/use 순서] $f:$violation — 선언 영역에서 mod 가 use 뒤에 나옴"
        fi
    done
}

# ────────────────────────────────────────────────────────────
# A.2  cargo fmt --check
# ────────────────────────────────────────────────────────────
# 루트 `cargo fmt` 는 workspace `exclude` 크레이트(site/, crates/tasty-plugin-sdk-wasm/)
# 를 보지 않는다 — 그 디렉토리의 .rs 가 staged 됐을 때만 manifest 를 따로 지정해
# 검사한다 (docs/dev-guide/site.md "왜 workspace 밖인가"). CI 에도 같은 게이트가
# 있다(.github/workflows/format-check.yml, main push + PR) — 이 훅은 그것을 커밋
# 시점으로 당겨 빠른 피드백을 주는 역할이고, 우회(`--no-verify`)해도 CI 가 잡는다.
EXCLUDED_CRATES="site crates/tasty-plugin-sdk-wasm"

check_cargo_fmt() {
    if [ -z "$STAGED_RS" ]; then return; fi
    if ! cargo fmt --check 2>/dev/null; then
        fail "[A.2 cargo fmt] 포맷 위반. \`cargo fmt\` 실행 후 다시 staging."
    fi
    for crate in $EXCLUDED_CRATES; do
        if grep -q "^$crate/" <<<"$STAGED_RS"; then
            if ! cargo fmt --check --manifest-path "$crate/Cargo.toml" 2>/dev/null; then
                fail "[A.2 cargo fmt] $crate/ 포맷 위반 (workspace exclude — 루트 cargo fmt 미검사). \`cargo fmt --manifest-path $crate/Cargo.toml\` 실행 후 다시 staging."
            fi
        fi
    done
}

# ────────────────────────────────────────────────────────────
# C.6  `let _ =` 주석 강제
# ────────────────────────────────────────────────────────────
# staged diff 의 추가 line 만 검사. "의도 명시" 로 인정하는 조건 (OR):
#   ① 같은 줄에 // 주석이 있음, 또는
#   ② 직전 라인 (새 파일 기준 바로 앞 라인 — 추가/컨텍스트 무관) 이 // 주석, 또는
#   ③ 바로 다음 라인 (새 파일 기준) 이 // 주석.
# docs/dev-guide/error-handling.md 의 윗줄 주석 관례 + 멀티라인 write! 케이스를
# 인정한다. ③ 은 rustfmt 가 trailing 주석이 달린 긴 라인을 포맷하며 주석을 다음
# 줄로 분리하는 케이스 (`let _ = foo(Bar {` + 다음 줄 `// 이유`) 를 수용한다.
# 주석이 같은 줄·윗줄·다음 줄 어디에도 없는 `let _ =` 는 여전히 거부.
# -U1 로 앞뒤 라인 컨텍스트를 확보하고, let 후보를 pending 으로 보류했다가 다음
# (새 파일에 존재하는) 라인이 주석인지 보고 판정한다.
check_let_underscore() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        local violation
        violation=$(git diff --cached -U1 -- "$f" | awk '
            function flush() { if (pending != "") { print pending; pending = "" } }
            /^@@/     { flush(); prev = ""; next }   # hunk 경계: 보류 후보 확정 + 컨텍스트 리셋
            /^\+\+\+/ { next }              # +++ b/file 헤더
            /^---/    { next }              # --- a/file 헤더
            {
                prefix  = substr($0, 1, 1)
                content = substr($0, 2)
                # 문자열 리터럴을 지운 사본으로 판정한다. 원문 그대로 보면 두 방향으로
                # 틀린다 — 문자열 안의 `let _ =` 를 코드로 잡고(거짓 양성), 문자열 안의
                # `//`(URL 이 대표적)를 사유 주석으로 인정한다(거짓 음성). 한 줄 안에서
                # 닫히지 않는 문자열(여러 줄 리터럴)은 diff 가 줄 단위라 여전히 근사다.
                code = content
                gsub(/"([^"\\]|\\.)*"/, "", code)
                if (prefix == "-") next     # 제거 라인: 새 파일에 없음 → 무시 (다음 줄 후보 아님)
                if (prefix == "+" || prefix == " ") {
                    # 직전 let 후보의 "다음 줄" 이 이 라인. 주석이면 사면, 아니면 위반 확정.
                    if (pending != "") {
                        if (content ~ /^[[:space:]]*\/\//) {
                            pending = ""    # ③ 다음 줄 주석 — OK
                        } else {
                            print pending   # 다음 줄 주석 아님 — 위반 확정
                            pending = ""
                        }
                    }
                    if (prefix == "+" && code ~ /let[[:space:]]+_[[:space:]]*=/) {
                        if (code ~ /\/\//) {
                            # ① 같은 줄 주석 — OK
                        } else if (prev ~ /^[[:space:]]*\/\//) {
                            # ② 윗줄 주석 — OK
                        } else {
                            pending = content   # ③ 판정 보류 — 다음 줄 주석 여부를 봐야 함
                        }
                    }
                    prev = content          # 새 파일에 존재하는 라인만 직전으로 갱신
                }
            }
            END { flush() }                 # 마지막 보류 후보 확정
        ')
        if [ -n "$violation" ]; then
            fail "[C.6 let _] $f — 주석 없는 \`let _ =\` 추가됨 (왜 무시하는지 주석 필요):"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ────────────────────────────────────────────────────────────
# C.8  UI 색상 하드코딩 — clippy::disallowed_methods 로 대체됨
# ────────────────────────────────────────────────────────────
# clippy.toml 의 disallowed-methods 가 정확히 같은 검사를 #[allow] 인식 + path
# resolution 포함해 수행한다. grep 기반 검사는 우리 의도된 외부 입력 사이트
# (settings 픽커, 이미지 픽셀 추출 등) 의 #[allow] 도 잡아 false positive 가 많음.
# pre-push 에서 cargo clippy 가 돈다 — 무거운 색 검사는 거기서 처리.
check_color_hardcode() {
    return 0
}

# ────────────────────────────────────────────────────────────
# C.9  egui::Window 직접 사용 (PopupManager 강제)
# ────────────────────────────────────────────────────────────
# staged diff 의 추가 line 만 검사.
check_egui_window() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        case "$f" in
            src/ui/popup/*) continue ;;
            src/ui/popup_defs.rs) continue ;;
            # 부팅 시점 렌더러 — PopupManager/AppState 가 살아있기 전 단계라
            # egui::Window 를 직접 쓸 수밖에 없다(docs/dev-guide/popup-implementation.md
            # 의 예외 항목). 앱 내부 다이얼로그는 여기 없다.
            src/gfx/gpu/shell_setup.rs) continue ;;
            src/gfx/gpu/boot_error.rs) continue ;;
        esac
        local violation
        violation=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -v '^+++' \
            | grep -E 'egui::Window::|egui::Window[[:space:]]*<' \
            || true)
        if [ -n "$violation" ]; then
            fail "[C.9 egui::Window] $f — PopupManager/PopupDef 시스템 사용 (docs/dev-guide/popup-implementation.md):"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ────────────────────────────────────────────────────────────
# C.11 println! / eprintln! (tracing 강제)
# ────────────────────────────────────────────────────────────
# 정책: staged diff 의 추가 라인만 검사 (changed-only).
# 예외 path — *CLI 응답 출력* 은 println 정당:
#   - src/main.rs                     : boot 진입점
#   - src/boot/cli_routing.rs         : clap 라우팅 (잠재적 println)
#   - crates/tasty-cli/*              : CLI 응답 출력 (tree, JSON, 에러 메시지 등
#                                       — caller 가 stdout/stderr 로 수신)
#   - crates/tasty-tui-simulator/*    : 테스트용 TUI simulator
#   - site/*                          : GitHub Pages 정적 사이트 생성기 (workspace
#                                       exclude 된 CLI 빌드 도구 — 생성 로그·경고를
#                                       stdout/stderr 로 내는 것이 정확한 동작)
#   - **/build.rs                     : cargo build script — `cargo:warning=` /
#                                       `cargo:rerun-if-changed=` 같은 directive 가
#                                       println 으로만 가능 (build.rs 에선 tracing
#                                       사용 불가)
#   - crates/tasty-doc-guards/src/bin/* : 게이트 스크립트가 부르는 CLI 판정기. 이 크레이트는
#                                       의존이 0 인 것이 존재 이유라(ADR-0138) tracing 을
#                                       들일 수 없고, 진단은 stdout/stderr 가 인터페이스다.
#                                       (`src/` 의 나머지는 예외가 아니다 — 라이브러리는
#                                       아무것도 출력하지 않는다)
# 그 외 .rs 파일은 tracing::info!/warn!/error! 사용.
check_println() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        case "$f" in
            src/main.rs) continue ;;
            src/boot/cli_routing.rs) continue ;;
            crates/tasty-cli/*) continue ;;
            crates/tasty-tui-simulator/*) continue ;;
            site/*) continue ;;
            build.rs) continue ;;
            */build.rs) continue ;;
            crates/tasty-doc-guards/src/bin/*) continue ;;
        esac
        local violation
        violation=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -v '^+++' \
            | grep -E '\b(println|eprintln)!' \
            | grep -vE '^\+[[:space:]]*//' \
            || true)
        if [ -n "$violation" ]; then
            fail "[C.11 println] $f — \`tracing::info!\` / \`tracing::warn!\` 등 사용:"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ────────────────────────────────────────────────────────────
# C.12 dbg! 매크로 (debug leak 방지)
# ────────────────────────────────────────────────────────────
# staged diff 의 추가 line 만 검사.
check_dbg() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        local violation
        violation=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -v '^+++' \
            | grep -E '\bdbg!' \
            | grep -vE '^\+[[:space:]]*//' \
            || true)
        if [ -n "$violation" ]; then
            fail "[C.12 dbg!] $f — \`dbg!\` 매크로 추가됨 (release 에 leak 금지):"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ────────────────────────────────────────────────────────────
# W.1  사용자 표면 변경 시 CHANGELOG 누락 (경고만, 커밋은 통과)
# ────────────────────────────────────────────────────────────
# CHANGELOG.md 는 "사용자가 의존하는 표면" 의 변경을 기록한다(CHANGELOG.md 머리말).
# 그 표면이 선언되는 파일이 staged 인데 CHANGELOG.md 는 staged 가 아니면 상기시킨다.
#   - crates/tasty-ipc/src/method_meta.rs   : IPC 메서드 표
#   - crates/tasty-cli/src/commands/        : CLI 서브커맨드
#   - crates/tasty-plugin-*/tasty-plugin.toml : plugin 매니페스트(권한·인자)
# **경고만 한다** — 그 파일을 만졌다고 반드시 표면이 바뀌는 것은 아니다(내부 refactor,
# 오타 수정, 버전 bump 만인 매니페스트). 하드 실패로 만들면 무해한 커밋마다
# --no-verify 를 쓰게 되고 훅 전체가 무력화된다. 판단은 사람이 한다.
check_changelog_reminder() {
    local staged surface
    staged=$(git diff --cached --name-only --diff-filter=ACMR)
    if grep -qx 'CHANGELOG.md' <<<"$staged"; then return; fi
    surface=$(echo "$staged" | grep -E \
        -e '^crates/tasty-ipc/src/method_meta\.rs$' \
        -e '^crates/tasty-cli/src/commands/' \
        -e '^crates/tasty-plugin-[^/]+/tasty-plugin\.toml$' \
        || true)
    if [ -z "$surface" ]; then return; fi
    yellow "▸ [W.1] 사용자 표면 선언 파일이 staged 인데 CHANGELOG.md 는 아니다:"
    echo "$surface" | sed 's/^/      /' >&2
    yellow "  표면이 실제로 바뀌었으면 CHANGELOG.md \`[Unreleased]\` 에 넣어라"
    yellow "  (내부 refactor·버전 bump 뿐이면 무시해도 된다 — 경고일 뿐 커밋은 진행된다)."
}

# ────────────────────────────────────────────────────────────
# P.1  plugin 산출물이 바뀌었는데 매니페스트 version 이 그대로
#
# 판정은 scripts/check-plugin-version-bump.sh 하나가 한다 — 훅과 CI 가 같은 것을
# 불러야 둘이 갈리지 않는다. 판별식(파일 수 문턱이 아니라 rustfmt 정규화 후 내용)의
# 근거·측정·대안은 docs/adr/0137-plugin-version-bump-is-judged-by-content-not-file-count.md.
#
# **비교 기준은 HEAD 가 아니라 main 과의 merge-base 다.** HEAD 와 비교하면 `--amend`
# 로 고쳐 커밋할 때 "이미 올린 그 커밋" 이 기준이 되어 두 번째 bump 를 요구하게 된다.
# merge-base 기준이면 "이 lane 이 main 대비 한 번 올렸는가" 를 묻게 되어 amend·rebase
# 어느 쪽에도 흔들리지 않고, 목적(반영 시점에 올라 있는가)과도 일치한다.
# main 이 없거나(단독 clone) merge-base 를 못 구하면 HEAD 로 떨어진다.
# ────────────────────────────────────────────────────────────
check_plugin_version_bump() {
    local staged_plugin base rc
    staged_plugin=$(git diff --cached --name-only --diff-filter=ACMRD \
        | /usr/bin/grep -E '^crates/tasty-plugin-[^/]+/' || true)
    if [ -z "$staged_plugin" ]; then return; fi

    base=$(git merge-base main HEAD 2>/dev/null || true)
    [ -n "$base" ] || base=HEAD

    set +e
    bash scripts/check-plugin-version-bump.sh --staged --base "$base"
    rc=$?
    set -e
    case "$rc" in
        0) ;;
        1) red "▸ [P.1] plugin 산출물이 바뀌었는데 매니페스트 version 이 그대로다 (위 목록)."
           FAIL=1 ;;
        *) # **판정 불가를 통과로 세지 않는다.** 이유는 스크립트가 이미 출력했다.
           red "▸ [P.1] 판정 불가 (exit $rc) — 위 사유를 해소하거나 --no-verify 로 우회해라."
           FAIL=1 ;;
    esac
}

