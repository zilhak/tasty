#!/usr/bin/env bash
# 커밋 전 코드 형식, 추가된 코드, 플러그인 버전, 문서 참조를 검사한다.
# 설치: git config core.hooksPath .githooks
# 검사별 범위와 실행 방법: docs/dev-guide/git-hooks.md

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACMR || true)
STAGED_RS=$(printf '%s\n' "$STAGED_ALL" | grep -E '\.rs$' || true)

red()    { printf '\033[31m%s\033[0m\n' "$*" >&2; }
yellow() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }

# ─
# M.1  merge 커밋 차단
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    red "✘ merge 커밋을 만들 수 없습니다. rebase와 fast-forward merge를 사용해 주세요."
    echo
    yellow "▸ 프로젝트는 rebase로 변경을 반영해 커밋 이력을 일렬로 유지합니다."
    yellow "  진행 중인 merge를 취소한 뒤 아래 순서로 다시 시도해 주세요."
    echo
    yellow "▸ 실행할 명령:"
    yellow "    git merge --abort"
    yellow "    git rebase <대상-브랜치>       # 충돌나면 양쪽 의도를 확인 후 해결"
    yellow "    # 대상 브랜치로 전환한 뒤 실행"
    yellow "    git merge --ff-only <작업-브랜치>"
    echo
    yellow "▸ 충돌이 발생하면 양쪽 변경이 필요한 이유를 확인하고 내용을 합쳐 주세요."
    yellow "  해결 방법이 확실하지 않으면 git rebase --abort로 중단할 수 있습니다."
    echo
    exit 1
fi

FAIL=0
fail() { red "  ✘ $*"; FAIL=1; }

# ─
# A.1  mod/use 선언 순서
check_mod_use_order() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        # vendor 코드는 원본과의 차이를 최소화하기 위해 선언 순서를 검사하지 않는다.
        case "$f" in vendor/*) continue ;; esac
        local violation
        violation=$(awk '
            /^[[:space:]]/ { next }
            /^\/\// { next }
            /^$/ { next }
            /^#\[/ { next }
            /^#!\[/ { next }
            /^(pub(\([^)]*\))?[[:space:]]+)?use[[:space:]]/ { if (!end_zone) saw_use = NR; next }
            /^(pub(\([^)]*\))?[[:space:]]+)?extern[[:space:]]+crate[[:space:]]/ { next }
            /^(pub(\([^)]*\))?[[:space:]]+)?mod[[:space:]]/ {
                if ($0 !~ /;[[:space:]]*$/) { end_zone = 1; next }
                if (saw_use && !end_zone) { print NR; exit }
                next
            }
            { end_zone = 1 }
        ' "$f")
        if [ -n "$violation" ]; then
            fail "[A.1 mod/use 순서] $f:$violation — mod 선언을 use 선언보다 앞에 배치해 주세요."
        fi
    done
}

# ─
# A.2  cargo fmt --check
EXCLUDED_CRATES="site crates/tasty-plugin-sdk-wasm"

check_cargo_fmt() {
    if [ -z "$STAGED_RS" ]; then return; fi
    if ! cargo fmt --check 2>/dev/null; then
        fail "[A.2 cargo fmt] 코드 형식이 맞지 않습니다. \`cargo fmt\` 실행 후 다시 git add해 주세요."
    fi
    for crate in $EXCLUDED_CRATES; do
        if grep -q "^$crate/" <<<"$STAGED_RS"; then
            if ! cargo fmt --check --manifest-path "$crate/Cargo.toml" 2>/dev/null; then
                fail "[A.2 cargo fmt] $crate/ 코드 형식이 맞지 않습니다. 이 크레이트는 워크스페이스 검사에 포함되지 않습니다. \`cargo fmt --manifest-path $crate/Cargo.toml\` 실행 후 다시 git add해 주세요."
            fi
        fi
    done
}

# ─
# A.3  셸 자산 정적 검사
check_shell_assets() {
    local rc
    if [ -z "$STAGED_ALL" ]; then return; fi

    # 셸 파일 선택 규칙을 중복하지 않도록 staged 목록 전체를 검사 스크립트에 넘긴다.
    set +e
    # 단어 분리가 목적이다 — 경로 목록을 가변 인자로 넘긴다.
    # shellcheck disable=SC2086
    bash scripts/check-shell-assets.sh $STAGED_ALL
    rc=$?
    set -e
    case "$rc" in
        0) ;;
        1) fail "[A.3 shell-assets] 셸 스크립트 검사에 실패했습니다. 위에 표시된 내용을 수정해 주세요." ;;
        *) fail "[A.3 shell-assets] 검사 도구를 실행하지 못했습니다 (종료 코드 $rc). 위의 설치 안내를 확인해 주세요." ;;
    esac
}

# ─
# C.6  `let _ =`로 값을 무시하는 이유 확인
check_let_underscore() {
    if [ -z "$STAGED_RS" ]; then return; fi

    local mask_bin="" masked="" staged_dir=""
    if [ -r "$REPO_ROOT/scripts/lib/judge-bin.sh" ]; then
        . "$REPO_ROOT/scripts/lib/judge-bin.sh"
        resolve_judge mask-source TASTY_MASK_SOURCE_BIN "$REPO_ROOT"
        mask_bin="$JUDGE_BIN"
    fi
    if [ -n "$mask_bin" ]; then
        staged_dir="$(mktemp -d)"
        for f in $STAGED_RS; do
            mkdir -p "$staged_dir/staged/$(dirname "$f")"
            git show ":$f" > "$staged_dir/staged/$f" 2>/dev/null || true
        done
        masked="$(mktemp -d)"
        if "$mask_bin" --keep-comments "$masked" "$staged_dir" staged >/dev/null 2>&1; then
            masked="$masked/staged"
        else
            rm -rf "$masked"; masked=""
        fi
        rm -rf "$staged_dir"
    fi
    if [ -z "$masked" ]; then
        echo "  [C.6] mask-source를 사용할 수 없어 간단한 정규식으로 검사합니다. 여러 줄 문자열에서 오탐이 발생할 수 있습니다. 위 [judge] 안내를 확인해 주세요." >&2
    fi

    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        # vendor 코드에는 원본 주석을 유지한다. 전체 검사에서는 별도 예외 목록을 사용한다.
        case "$f" in vendor/*) continue ;; esac
        local violation masked_file=""
        if [ -n "$masked" ] && [ -f "$masked/$f" ]; then masked_file="$masked/$f"; fi
        violation=$(git diff --cached -U1 -- "$f" | awk -v maskfile="$masked_file" '
            # 문자열을 제거한 소스를 줄 번호로 읽는다. 없으면 한 줄 정규식으로 검사한다.
            BEGIN { if (maskfile != "") { while ((getline ml < maskfile) > 0) MASK[++mn] = ml } }
            function flush() { if (pending != "") { print pending; pending = "" } }
            # 위쪽 사유 주석을 찾을 때 빈 줄과 `#[..]` 속성 줄은 건너뛴다.
            # 소스 사본이 없으면 바로 윗줄만 확인한다.
            function comment_above(ln,   i, l) {
                if (mn == 0) return (prev ~ /^[[:space:]]*\/\//)
                for (i = ln - 1; i >= 1; i--) {
                    if (!(i in MASK)) return 0
                    l = MASK[i]
                    if (l ~ /^[[:space:]]*$/)    continue
                    if (l ~ /^[[:space:]]*#\[/)  continue
                    return (l ~ /^[[:space:]]*\/\//)
                }
                return 0
            }
            # hunk가 바뀌면 이전 후보를 처리하고 새 파일의 줄 번호를 구한다.
            /^@@/ {
                flush(); prev = ""
                if (match($0, /\+[0-9]+/)) nl = substr($0, RSTART + 1, RLENGTH - 1) - 1
                next
            }
            /^\+\+\+/ { next }              # +++ b/file 헤더
            /^---/    { next }              # --- a/file 헤더
            {
                prefix  = substr($0, 1, 1)
                content = substr($0, 2)
                if (prefix == "-") next
                if (prefix != "+" && prefix != " ") next
                nl++
                # 문자열을 제거한 사본을 우선 사용한다. 정규식은 여러 줄 문자열을 처리하지 못한다.
                if (mn > 0 && nl in MASK) { mline = MASK[nl] }
                else { mline = content; gsub(/"([^"\\]|\\.)*"/, "", mline) }
                code = mline; sub(/\/\/.*/, "", code)   # 주석을 뺀 코드 부분
                # 이전 줄의 let 구문에 이어지는 주석이 있으면 허용한다.
                if (pending != "") {
                    if (mline ~ /^[[:space:]]*\/\//) {
                        pending = ""
                    } else {
                        print pending
                        pending = ""
                    }
                }
                if (prefix == "+" && code ~ /let[[:space:]]+_[[:space:]]*=/) {
                    if (mline ~ /\/\//) {
                        # 같은 줄에 사유 주석이 있다.
                    } else if (comment_above(nl)) {
                        # 위쪽에 사유 주석이 있다.
                    } else {
                        pending = content   # 다음 줄에 주석이 있는지 확인한다.
                    }
                }
                prev = mline
            }
            END { flush() }
        ')
        if [ -n "$violation" ]; then
            fail "[C.6 let _] $f — \`let _ =\`로 값을 무시하는 이유를 주석으로 적어 주세요:"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ─
# C.8  UI 색상 하드코딩
check_color_hardcode() {
    # 실제 검사는 Clippy로 이전했다. 기존 검사 ID와 실행 목록을 유지한다.
    return 0
}

# ─
# C.9  egui::Window 대신 PopupManager 사용
check_egui_window() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        case "$f" in
            src/ui/popup/*) continue ;;
            src/ui/popup_defs.rs) continue ;;
            # PopupManager 초기화 전의 부팅 화면은 egui::Window 직접 사용을 허용한다.
            src/gfx/gpu/shell_setup.rs) continue ;;
            src/gfx/gpu/boot_error.rs) continue ;;
        esac
        local violation
        violation=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -v '^+++' \
            | grep -E 'egui::Window::|egui::Window[[:space:]]*<' \
            || true)
        if [ -n "$violation" ]; then
            fail "[C.9 egui::Window] $f — egui::Window 대신 PopupManager/PopupDef를 사용해 주세요 (docs/dev-guide/popup-implementation.md):"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ─
# C.11 println! / eprintln! 대신 tracing 사용
check_println() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        case "$f" in
            src/main.rs) continue ;;
            src/boot/cli_routing.rs) continue ;;
            crates/tasty-cli/*) continue ;;
            crates/tasty-tui-simulator/*) continue ;;
            site/*) continue ;;
            build.rs) continue ;;
            */build.rs) continue ;;
            crates/tasty-latency-control/*) continue ;;
            src/source_guards/*) continue ;;
            crates/tasty-doc-guards/src/bin/*) continue ;;
            crates/tasty-doc-guards/tests/*) continue ;;
        esac
        local violation
        violation=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -v '^+++' \
            | grep -E '\b(println|eprintln)!' \
            | grep -vE '^\+[[:space:]]*//' \
            || true)
        if [ -n "$violation" ]; then
            fail "[C.11 println] $f — \`tracing::info!\` / \`tracing::warn!\` 등을 사용해 주세요:"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ─
# C.12 추가된 dbg! 매크로 확인
check_dbg() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        local violation
        violation=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -v '^+++' \
            | grep -E '\bdbg!' \
            | grep -vE '^\+[[:space:]]*//' \
            || true)
        if [ -n "$violation" ]; then
            fail "[C.12 dbg!] $f — 디버그 출력이 남지 않도록 \`dbg!\`를 제거해 주세요:"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ─
# W.1  사용자 기능 변경 시 CHANGELOG 작성 안내 (경고만)
check_changelog_reminder() {
    local staged surface
    staged=$(git diff --cached --name-only --diff-filter=ACMR)
    if grep -qx 'CHANGELOG.md' <<<"$staged"; then return; fi
    surface=$(echo "$staged" | grep -E \
        -e '^crates/tasty-ipc/src/method_meta\.rs$' \
        -e '^crates/tasty-cli/src/commands/' \
        -e '^crates/tasty-plugin-[^/]+/tasty-plugin\.toml$' \
        || true)
    if [ -z "$surface" ]; then return; fi
    yellow "▸ [W.1] 명령이나 플러그인 설정 파일이 변경됐지만 CHANGELOG.md는 변경되지 않았습니다:"
    echo "$surface" | sed 's/^/      /' >&2
    yellow "  사용자가 쓰는 기능이 달라졌다면 CHANGELOG.md의 \`[Unreleased]\`에 적어 주세요."
    yellow "  (내부 리팩터링이나 버전 변경만 있다면 생략할 수 있습니다. 이 안내는 커밋을 막지 않습니다.)"
}

# ─
# W.2  새 파일에 필요한 테스트 명령 안내 (경고만)
suggest_target() {
    # $1 = 테스트 파일 경로, $2 = 실행 명령, $3 = 검사 내용
    if [ -f "$1" ]; then
        yellow "      $2"
        yellow "        ↳ $3"
    else
        yellow "      (테스트 파일 $1을 찾을 수 없습니다. 이 훅의 W.2 안내 목록을 갱신해 주세요.)"
    fi
}

# 검사 안내가 등록된 파일 경로 패턴. 분류되지 않은 파일을 찾을 때도 사용한다.
KNOWN_KIND_RE='^(tests/[^/]+\.rs|crates/[^/]+/tests/[^/]+\.rs|crates/[^/]+/Cargo\.toml|src/.*\.rs|crates/[^/]+/src/.*\.rs|docs/.*\.md|scripts/.*\.sh|\.githooks/[^/]+|site/.*)$'

check_new_file_judges() {
    local added new_int_test new_crate new_src new_doc new_shell new_site unknown
    added=$(git diff --cached --name-only --diff-filter=A || true)
    if [ -z "$added" ]; then return; fi

    new_int_test=$(echo "$added" | /usr/bin/grep -E '^(tests/[^/]+\.rs|crates/[^/]+/tests/[^/]+\.rs)$' || true)
    new_crate=$(echo "$added" | /usr/bin/grep -E '^crates/[^/]+/Cargo\.toml$' || true)
    new_src=$(echo "$added" | /usr/bin/grep -E '^(src/|crates/[^/]+/src/).*\.rs$' || true)
    new_doc=$(echo "$added" | /usr/bin/grep -E '^docs/.*\.md$' || true)
    new_shell=$(echo "$added" | /usr/bin/grep -E '^(scripts/.*\.sh|\.githooks/[^/]+)$' || true)
    new_site=$(echo "$added" | /usr/bin/grep -E '^site/' || true)
    unknown=$(echo "$added" | /usr/bin/grep -vE "$KNOWN_KIND_RE" || true)

    if [ -z "$new_int_test$new_crate$new_src$new_doc$new_shell$new_site$unknown" ]; then return; fi

    yellow "▸ [W.2] 새 파일에 필요한 검사 명령을 안내합니다."
    yellow "  -p <크레이트>로 실행한 테스트에는 루트 패키지의 테스트가 포함되지 않습니다."

    if [ -n "$new_int_test" ]; then
        yellow "  새 통합 테스트 타깃:"
        echo "$new_int_test" | sed 's/^/      /' >&2
        suggest_target "crates/tasty-doc-guards/tests/let_underscore_documented.rs" \
            "cargo test --locked -p tasty-doc-guards --test let_underscore_documented" \
            "통합 테스트 파일에 필요한 lint 예외 선언을 검사합니다."
        suggest_target "src/source_guards/repo_relative_paths.rs" \
            "cargo test --locked -p tasty --lib" \
            "src/source_guards/의 소스 검사를 실행합니다. tasty-doc-guards 테스트와 별도로 실행해 주세요."
    fi
    if [ -n "$new_crate" ]; then
        yellow "  새 크레이트:"
        echo "$new_crate" | sed 's/^/      /' >&2
        suggest_target "crates/tasty-doc-guards/tests/architecture_crate_list_complete.rs" \
            "cargo test --locked -p tasty-doc-guards --test architecture_crate_list_complete" \
            "크레이트 목록과 문서가 일치하는지 검사합니다."
        yellow "      cargo deny check licenses"
        yellow "        ↳ Cargo.toml의 license 선언을 검사합니다."
    fi
    if [ -n "$new_src" ]; then
        yellow "  새 소스 파일:"
        echo "$new_src" | sed 's/^/      /' >&2
        suggest_target "crates/tasty-doc-guards/tests/no_emoji_in_source.rs" \
            "cargo test --locked -p tasty-doc-guards --test no_emoji_in_source --test no_hardcoded_ui_strings" \
            "소스의 이모지와 번역되지 않은 UI 문자열을 검사합니다."
    fi
    if [ -n "$new_doc" ]; then
        yellow "  새 문서:"
        echo "$new_doc" | sed 's/^/      /' >&2
        suggest_target "crates/tasty-doc-guards/tests/no_checkbox_in_docs.rs" \
            "cargo test --locked -p tasty-doc-guards" \
            "문서의 체크박스, 표, 파일 참조를 검사합니다."
    fi
    if [ -n "$new_shell" ]; then
        yellow "  새 셸 스크립트:"
        echo "$new_shell" | sed 's/^/      /' >&2
        suggest_target "crates/tasty-doc-guards/tests/no_early_exit_consumer_in_shell_pipes.rs" \
            "cargo test --locked -p tasty-doc-guards --test no_early_exit_consumer_in_shell_pipes" \
            "셸 파이프라인의 오류 처리를 검사합니다. 확장자가 없는 Git 훅도 포함됩니다."
    fi
    if [ -n "$new_site" ]; then
        yellow "  새 사이트 파일:"
        echo "$new_site" | sed 's/^/      /' >&2
        yellow "      (cd site && npm run build)"
        yellow "        ↳ Astro의 import와 문법을 검사합니다. pages.yml에서도 실행합니다."
        yellow "      (cd site && npm run check-links)"
        yellow "        ↳ site/content/ 문서의 링크를 검사합니다."
        yellow "        ↳ site/src/의 스타일 규칙은 Rust 테스트로 검사하지 않으므로 별도로 확인해 주세요."
    fi
    if [ -n "$unknown" ]; then
        yellow "  ▸ 추천 검사 명령이 등록되지 않은 새 파일:"
        echo "$unknown" | sed 's/^/      /' >&2
        yellow "        ↳ 이 파일을 검사하는 테스트가 있다면 W.2 안내 목록에 추가해 주세요."
        yellow "          이미지 등 별도 검사가 필요 없는 파일은 생략할 수 있습니다."
    fi
    yellow "  (이 안내는 커밋을 막지 않습니다. 이미 실행한 검사는 다시 실행하지 않아도 됩니다.)"
}

# ─
# P.1  플러그인 변경에 따른 버전 갱신 확인
check_plugin_version_bump() {
    local staged_any base rc
    staged_any=$(git diff --cached --name-only --diff-filter=ACMRD || true)
    if [ -z "$staged_any" ]; then return; fi

    base=$(git merge-base main HEAD 2>/dev/null || true)
    [ -n "$base" ] || base=HEAD

    set +e
    bash scripts/check-plugin-version-bump.sh --staged --base "$base"
    rc=$?
    set -e
    case "$rc" in
        0) ;;
        1) red "▸ [P.1] 플러그인 코드가 변경됐지만 버전이 그대로입니다. 위 목록의 플러그인 버전을 올려 주세요."
           FAIL=1 ;;
        *) # 검사 도구 오류도 커밋을 중단한다.
           red "▸ [P.1] 버전을 검사하지 못했습니다 (종료 코드 $rc). 위에 표시된 원인을 해결해 주세요."
           FAIL=1 ;;
    esac
}

# ─
# T.1  로컬 전용 문서 참조 확인
check_todo_citation() {
    local out rc
    # 출력과 종료 코드를 따로 저장해 cargo 실패가 로그 출력 결과에 가려지지 않게 한다.
    set +e
    out=$(cargo test -q -p tasty-doc-guards --test no_todo_file_citation 2>&1)
    rc=$?
    set -e
    if [ "$rc" -ne 0 ]; then
        printf '%s\n' "$out" | tail -40 >&2
        red "▸ [T.1] 다른 개발자가 열 수 없는 로컬 문서 참조가 있습니다. 위 목록의 참조를 수정해 주세요."
        red "    이 검사는 저장소 전체를 확인하므로 커밋 대상이 아닌 파일에서도 실패할 수 있습니다."
        FAIL=1
    fi
}

CHECKS=(
    check_mod_use_order
    check_cargo_fmt
    check_shell_assets
    check_let_underscore
    check_color_hardcode
    check_egui_window
    check_println
    check_dbg
    check_plugin_version_bump
    check_todo_citation
    check_changelog_reminder
    check_new_file_judges
)

defined=$(grep -cE '^check_[a-z_]+\(\) \{' "$0" || true)

if [ "${#CHECKS[@]}" -eq 0 ] || [ "$defined" -eq 0 ]; then
    red "▸ [훅] 등록된 검사가 없습니다 (함수 $defined개, 실행 목록 ${#CHECKS[@]}개)."
    red "    CHECKS 배열과 check_* 함수 선언을 확인해 주세요."
    red "    검사를 실행할 수 없어 커밋을 중단합니다."
    exit 1
fi

if [ "$defined" -ne "${#CHECKS[@]}" ]; then
    red "▸ [훅] 검사 함수 수($defined)와 실행 목록 수(${#CHECKS[@]})가 다릅니다."
    if [ "$defined" -gt "${#CHECKS[@]}" ]; then
        red "    실행 목록에 빠진 검사 함수를 CHECKS에 추가해 주세요."
    else
        red "    CHECKS에 적힌 함수 이름이 올바른지 확인해 주세요."
    fi
    exit 1
fi

RAN=0
for _check in "${CHECKS[@]}"; do
    "$_check"
    RAN=$((RAN + 1))
done

if [ "$FAIL" -ne 0 ]; then
    echo >&2
    red "✘ 커밋 전 검사에 실패했습니다. 위 항목을 수정한 뒤 다시 커밋해 주세요."
    exit 1
fi

count() { [ -z "$1" ] && echo 0 || printf '%s\n' "$1" | wc -l | tr -d ' '; }

green "✓ pre-commit 검사 통과 (검사 $RAN/$defined 실행 · 커밋 대상 Rust 파일 $(count "$STAGED_RS") · 전체 파일 $(count "$STAGED_ALL") — 추가·수정·이름 변경 포함)"

# 삭제된 파일이 있을 때만 추가로 안내한다.
STAGED_WIDE=$(git diff --cached --name-only --diff-filter=ACMRD || true)
wide_extra=$(( $(count "$STAGED_WIDE") - $(count "$STAGED_ALL") ))
if [ "$wide_extra" -gt 0 ]; then
    yellow "  ↳ 삭제된 파일 $wide_extra개는 위 파일 수에 포함되지 않습니다. P.1 버전 검사에서는 확인합니다."
fi

untracked=$(git status --porcelain --untracked-files=normal 2>/dev/null | grep -c '^??' || true)
if [ "$untracked" -gt 0 ]; then
    yellow "  ↳ 아직 git add하지 않은 새 파일 $untracked개가 있습니다. 위 파일 수에는 포함되지 않습니다."
    yellow "     \`git status --porcelain\`로 파일 목록을 확인해 주세요. 전체 문서 검사는 \`cargo test -p tasty-doc-guards\`로 실행합니다."
fi
exit 0
