fi

# ────────────────────────────────────────────────────────────
# 통과 줄에 **모수**를 붙인다.
#
# 이 훅의 각 구역은 자기 모수를 머리 주석에 적어 뒀다(`[파일 전체]` · `[diff 추가 라인]`
# · `[staged]`). 그런데 그 표기는 판정의 **정의** 옆에 있고, 커밋하는 사람이 보는 것은
# 판정의 **출력** — 모수가 없는 한 줄이었다. 그래서 초록이 "staged 범위가 깨끗하다" 가
# 아니라 "트리가 깨끗하다" 로 읽혔다. 실제로 그렇게 읽혀서, 추적 안 되는 쓰레기 파일이
# 훅을 초록으로 통과한 채 남았다(레포 전체를 훑는 doc-guards 가드가 나중에 잡았다).
#
# 값은 **새로 세지 않는다.** 위에서 검사들에게 넘긴 바로 그 목록의 길이를 쓴다 — 여기서
# git 을 다시 부르면 그 계수기가 판정과 다른 모수를 갖게 되고, 그러면 이 줄이 고치려던
# 병을 이 줄이 다시 만든다.
#
# ★ P.1 · W.1 은 아래 수보다 **넓게** 본다(이름 바뀜 · 지움까지). 전에는 "안 가진 값을
# 찍느니 안 찍는 것이 낫다" 고 적고 대신 "ACM 기준" 이라는 필터 문자를 달았다. 둘 다 틀렸다 —
# 그 값은 git 한 번으로 가질 수 있고, 필터 문자는 뜻을 옮기지 않는다. 넓은 쪽이 **더 본 것이
# 있을 때만** 아래에 한 줄 더 찍는다. 늘 찍으면 문장이 안 변해 다시 벽지가 된다.
# ────────────────────────────────────────────────────────────
count() { [ -z "$1" ] && echo 0 || printf '%s\n' "$1" | wc -l | tr -d ' '; }

green "✓ pre-commit 검사 통과 (모수: staged .rs $(count "$STAGED_RS") · staged 전체 $(count "$STAGED_ALL") — 더해지거나 고쳐진 것)"

# 넓은 쪽과의 차이. 0 이면 안 찍는다 — 이 줄이 **상황에 반응해야** 뜻이 산다.
STAGED_WIDE=$(git diff --cached --name-only --diff-filter=ACMRD || true)
wide_extra=$(( $(count "$STAGED_WIDE") - $(count "$STAGED_ALL") ))
if [ "$wide_extra" -gt 0 ]; then
    yellow "  ↳ 이름만 바뀌거나 지워진 것 $wide_extra 개는 **위 수 밖**이다 — P.1 과 W.1 은 그것도 본다."
fi

# 그리고 **여집합**을 한 줄 더 찍는다 — 있을 때만.
#
# 위 수만으로는 부족했다(실측): 추적 안 되는 쓰레기 파일을 놓아도 통과 줄이 **글자 하나
# 안 바뀐다.** 범위를 말해 주기는 하지만 그 문장이 늘 같아서 벽지가 된다. 초록을 "트리가
# 깨끗하다" 로 읽는 것을 막으려면 출력이 **그 상황에 반응**해야 한다.
#
# ★ 이 수는 **어느 검사의 모수도 아니다.** 모든 모수의 **밖**이다 — 그래서 위의 수들과
#   달라도 어긋난 것이 아니다. 라벨에 그 사실을 적는다.
untracked=$(git status --porcelain --untracked-files=normal 2>/dev/null | grep -c '^??' || true)
if [ "$untracked" -gt 0 ]; then
    yellow "  ↳ 추적 안 되는 파일 $untracked 개는 **위 모수 밖**이다 — 이 초록이 말하지 않는 것이다."
    yellow "     의도한 것이 아니면 \`git status --porcelain\` 로 봐라. 트리 전체는 \`cargo test -p tasty-doc-guards\`."
fi
exit 0
