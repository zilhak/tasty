#!/usr/bin/env bash
# merge 커밋 생성을 막는다. fast-forward merge에는 이 훅이 실행되지 않는다.
# 충돌 해결 후 git commit으로 만드는 merge 커밋은 pre-commit의 M.1에서 검사한다.
# 설치: git config core.hooksPath .githooks
set -e

red()    { printf '\033[31m%s\033[0m\n' "$*" >&2; }
yellow() { printf '\033[33m%s\033[0m\n' "$*" >&2; }

red 'merge 커밋을 만들 수 없습니다. rebase와 fast-forward merge를 사용해 주세요.'
yellow '현재 merge가 진행 중이므로 먼저 취소해 주세요:'
yellow '    git merge --abort'
yellow '그런 다음 작업 브랜치에서 대상 브랜치의 변경을 반영해 주세요:'
yellow '    git rebase <대상-브랜치>'
yellow '대상 브랜치로 전환한 뒤 작업 브랜치를 합쳐 주세요:'
yellow '    git merge --ff-only <작업-브랜치>'
yellow '충돌이 발생하면 양쪽 변경이 필요한 이유를 확인하고 내용을 합쳐 주세요.'
yellow '해결 방법이 확실하지 않으면 git rebase --abort로 중단할 수 있습니다.'
exit 1
