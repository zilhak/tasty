#!/usr/bin/env bash
# push할 커밋의 플러그인 버전과 파일 수를 확인한 뒤 빌드·문서를 검사한다.
# 설치: git config core.hooksPath .githooks
# 검사별 실행 방법: docs/dev-guide/git-hooks.md
set -e -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
red()    { printf '\033[31m%s\033[0m\n' "$*" >&2; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*" >&2; }

FAIL=0
STARTED=$SECONDS
LOG_ROOT="$(git rev-parse --git-path hook-logs)"
mkdir -p "$LOG_ROOT"
LOG_DIR="$(mktemp -d "$LOG_ROOT/pre-push.XXXXXX")"
SUMMARY="$LOG_DIR/summary.log"
printf 'push 전 검사를 시작합니다. 전체 로그: %s\n' "$LOG_DIR"

# 명령의 종료 코드를 직접 확인한다. 출력은 검사별로 저장하고 실패 시 마지막 60줄을 보여 준다.
run_check() {
    local id="$1" title="$2" started=$SECONDS rc=0
    shift 2
    yellow "[$id] 시작: $title"
    if "$@" > "$LOG_DIR/$id.log" 2>&1; then
        green "[$id] 통과 ($((SECONDS - started))초)"
        printf '%s 통과 %s초 — %s\n' "$id" "$((SECONDS - started))" "$title" >> "$SUMMARY"
    else
        rc=$?
        tail -60 "$LOG_DIR/$id.log" >&2
        red "[$id] 실패 ($((SECONDS - started))초, 종료 코드 $rc). 전체 로그: $LOG_DIR/$id.log"
        printf '%s 실패 %s초 — %s\n' "$id" "$((SECONDS - started))" "$title" >> "$SUMMARY"
        FAIL=1
    fi
}

finish() {
    printf '\npush 전 검사 결과 (총 %s초)\n' "$((SECONDS - STARTED))"
    cat "$SUMMARY"
    if [ "$FAIL" -ne 0 ]; then
        red "push를 중단했습니다. 실패한 항목을 수정하고 커밋한 뒤 다시 push해 주세요."
        return 1
    fi
    green "실행한 push 전 검사를 모두 통과했습니다."
}

GIT_NULL_SHA=0000000000000000000000000000000000000000
PUSH_REMOTE="${1:-origin}"
PUSH_REFS=""
PUSH_INVOKED_BY_GIT=0
# Git이 전달하는 ref 목록은 두 검사에서 함께 사용한다. 직접 실행할 때는 stdin을 기다리지 않는다.
if [ "$#" -ge 1 ] && [ ! -t 0 ]; then
    PUSH_INVOKED_BY_GIT=1
    PUSH_REFS="$(cat)"
fi

# ─
# B.9  원격에 게시된 버전과 push할 플러그인 버전 비교
check_published_plugin_version() {
    local considered=0 judged=0 failed=0 rc
    local local_ref local_sha remote_ref remote_sha
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ -n "${local_ref:-}" ] || continue
        considered=$((considered + 1))
        if [ "$local_sha" = "$GIT_NULL_SHA" ]; then
            echo "$remote_ref: 삭제할 ref이므로 버전 검사를 생략합니다."
            continue
        fi
        if [ "$remote_sha" = "$GIT_NULL_SHA" ]; then
            echo "$remote_ref: 새 ref이므로 비교할 원격 버전이 없습니다."
            continue
        fi
        if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
            red "$remote_ref: 원격 커밋 $remote_sha를 로컬에서 찾을 수 없습니다."
            red "git fetch $PUSH_REMOTE 후 다시 시도해 주세요. 얕은 복제라면 git fetch --unshallow가 필요합니다."
            failed=1
            continue
        fi
        judged=$((judged + 1))
        rc=0
        bash scripts/check-plugin-version-bump.sh --range "$remote_sha" "$local_sha" || rc=$?
        if [ "$rc" -eq 1 ]; then
            red "$remote_ref: 변경된 플러그인의 버전이 원격에 게시된 버전보다 높아야 합니다."
            red "위 목록의 Cargo.toml과 tasty-plugin.toml 버전을 함께 올려 주세요."
            red "cargo check로 Cargo.lock도 갱신하고 세 파일을 함께 커밋해 주세요."
            failed=1
        elif [ "$rc" -ne 0 ]; then
            red "$remote_ref: 버전을 검사하지 못했습니다 (종료 코드 $rc). 위 오류를 확인해 주세요."
            failed=1
        fi
    done <<EOF
$PUSH_REFS
EOF
    echo "ref $considered개: 검사 $judged개, 생략 $((considered - judged))개"
    return "$failed"
}

# ─
# B.10  push할 커밋의 실제 파일 수와 검사 기준 비교
check_published_populations() {
    local considered=0 judged=0 failed=0 rc
    local local_ref local_sha remote_ref remote_sha
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ -n "${local_ref:-}" ] || continue
        considered=$((considered + 1))
        if [ "$local_sha" = "$GIT_NULL_SHA" ]; then
            echo "$remote_ref: 삭제할 ref이므로 파일 수 검사를 생략합니다."
            continue
        fi
        judged=$((judged + 1))
        rc=0
        bash scripts/check-population-freshness.sh --rev "$local_sha" || rc=$?
        if [ "$rc" -eq 1 ]; then
            red "$remote_ref: 실제 파일 수와 검사 기준이 다릅니다."
            red "crates/tasty-doc-guards/src/floored_walk.rs의 해당 measured, measured_on, counted_on을 갱신해 주세요."
            red "이 검사는 커밋을 확인합니다. 수정 사항을 커밋한 뒤 다시 push해 주세요."
            failed=1
        elif [ "$rc" -ne 0 ]; then
            red "$remote_ref: 파일 수를 검사하지 못했습니다 (종료 코드 $rc). 위 오류를 확인해 주세요."
            failed=1
        fi
    done <<EOF
$PUSH_REFS
EOF
    echo "ref $considered개: 검사 $judged개, 생략 $((considered - judged))개"
    return "$failed"
}

if [ "$PUSH_INVOKED_BY_GIT" -eq 1 ]; then
    if [ -z "$PUSH_REFS" ]; then
        green "push할 변경 사항이 없어 검사를 생략합니다."
        exit 0
    fi
    run_check B.9 '플러그인 버전' check_published_plugin_version
    run_check B.10 '파일 수 검사 기준' check_published_populations
    if [ "$FAIL" -ne 0 ]; then
        yellow '커밋 검사에 실패해 빌드 검사는 실행하지 않습니다.'
        finish
        exit 1
    fi
else
    yellow '[B.9] 생략: 직접 실행했으므로 Git의 원격 ref 정보가 없습니다.'
    yellow '직접 검사: bash scripts/check-plugin-version-bump.sh --range <원격 커밋> HEAD'
    yellow '[B.10] 생략: 직접 검사하려면 bash scripts/check-population-freshness.sh --rev HEAD'
    printf 'B.9 생략 — Git의 ref 정보 없음\nB.10 생략 — Git의 ref 정보 없음\n' >> "$SUMMARY"
fi

# ─
# B.5  워크스페이스의 개발 빌드와 테스트 코드 컴파일
run_check B.5 'cargo check --workspace --all-targets' cargo check --workspace --all-targets

# ─
# B.8  release 설정으로 워크스페이스 컴파일
run_check B.8 'cargo check --workspace --release --locked' cargo check --workspace --release --locked

# ─
# B.6  GUI 기능을 제외한 headless 빌드 컴파일
run_check B.6 'cargo check --no-default-features' cargo check --no-default-features

# ─
# B.4  Clippy 검사: correctness 경고는 오류로 처리
run_check B.4 'cargo clippy --workspace --all-targets -- -D clippy::correctness' cargo clippy --workspace --all-targets -- -D clippy::correctness

# ─
# B.7  문서, 매니페스트, 인덱스 검사
run_check B.7 'cargo test -p tasty-doc-guards' cargo test -p tasty-doc-guards

finish
