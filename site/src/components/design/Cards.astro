---
/** Iframes isolate guideline CSS and preserve the declared viewport width. */
import { byGroup, type Card } from "../../lib/guidelines";
import { REPO, url } from "../../lib/site";

interface Props {
  cards: Card[];
  sourceLabel: string;
}
const { cards, sourceLabel } = Astro.props;
const groups = byGroup(cards);
const anchor = (g: string) => g.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---
{groups.map((g) => (
  <section class="ds-group" id={anchor(g.group)}>
    <h2>{g.group}</h2>
    {g.cards.map((c) => (
      <figure class="ds-card">
        <figcaption class="ds-card__head">
          <h3>{c.name}</h3>
          <p>{c.subtitle}</p>
          <a class="ds-card__src" href={`${REPO}/blob/main/site/vendor/guidelines/${c.slug}.html`}>
            {sourceLabel} <code>{c.slug}.html</code>
          </a>
        </figcaption>
        <div class="ds-card__frame">
          <iframe src={url(`design/cards/${c.slug}.html`)} title={c.name}
                  height={c.height} loading="lazy"
                  style={`min-width:${c.width}px`} />
        </div>
      </figure>
    ))}
  </section>
))}
