---
/** `/design/` — the guideline cards, minus the token-system page's own route. */
import Design from "../../layouts/Design.astro";
import Cards from "./Cards.astro";
import { cards } from "../../lib/guidelines";
import { GALLERY_GROUPS, galleryPath } from "../../lib/design";
import { url } from "../../lib/site";
import type { Lang } from "../../lib/guide";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const COPY = {
  en: {
    title: "Design foundations",
    intro:
      "Explore the colours, typography, and spacing that shape Tasty. The examples below use " +
      "the app's <code>--tasty-*</code> design tokens, so they stay in step with the design system.",
    source: "View source:",
    galleryTitle: "Explore the components",
    galleryBody:
      "Try buttons, menus, and layouts in the gallery. Each example explains when to use it, " +
      "how it behaves, and which dimensions and tokens it uses.",
  },
  ko: {
    title: "디자인 살펴보기",
    intro:
      "Tasty의 색, 글꼴, 간격이 화면에서 어떻게 쓰이는지 살펴보세요. 아래 예시는 앱과 같은 " +
      "<code>--tasty-*</code> 디자인 토큰을 사용하므로 디자인 시스템의 변경 사항이 함께 반영됩니다.",
    source: "원본 보기:",
    galleryTitle: "컴포넌트 직접 살펴보기",
    galleryBody:
      "갤러리에서 버튼, 메뉴, 화면 배치를 직접 사용해 보세요. 각 예시에서 사용 목적과 동작, " +
      "크기와 디자인 토큰을 확인할 수 있습니다.",
  },
};
const c = COPY[lang];
const all = cards(process.cwd()).filter((x) => x.group !== "Tokens");
---
<Design lang={lang} current="" title={c.title} intro={c.intro}>
  <section class="ds-group">
    <h2>{c.galleryTitle}</h2>
    <p class="ds-lede">{c.galleryBody}</p>
    <ul class="ds-tiles">
      {GALLERY_GROUPS.flatMap((g) => g.pages).map((page) => (
        <li>
          <a href={url(galleryPath(page.slug))}>
            <span class="ds-tiles__label">{page.label}</span>
            <span class="ds-tiles__desc">{page.desc}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Cards cards={all} sourceLabel={c.source} />
</Design>
