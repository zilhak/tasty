---
import { getCollection, render } from "astro:content";
import Guide from "../../../layouts/Guide.astro";
import { buildPages, entryIdFor } from "../../../lib/guide";
import { slugOf } from "../../../lib/urls";

export async function getStaticPaths() {
  const pages = buildPages(process.cwd());
  const entries = await getCollection("guide");
  return pages.map((page, idx) => {
    const id = entryIdFor(page, "ko");
    const entry = entries.find((e) => e.id === id);
    if (!entry) throw new Error(`no content entry for ${id}`);
    return {
      params: { slug: slugOf(page.rel) || undefined },
      props: { page, pages, idx, entry },
    };
  });
}

const { page, pages, idx, entry } = Astro.props;
const { Content, headings } = await render(entry);
// The kit's styles are linked per page, so the layout has to know before it
// renders. The marker is in the source, which is the one place it is certain.
const hasDiagram = /<!--\s*tasty-diagram:/.test(entry.body ?? "");
---
<Guide lang="ko" page={page} pages={pages} idx={idx} headings={headings} hasDiagram={hasDiagram}>
  <Content />
</Guide>
