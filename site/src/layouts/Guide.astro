---
/** Guide page: sidebar, article, table of contents. */
import Base from "./Base.astro";
import { SECTIONS, titleIn, navLabelIn, stateOf, TRANSLATION_DIR } from "../lib/guide";
import type { Page, Lang } from "../lib/guide";
import { pathOf } from "../lib/urls";
import { stringsFor } from "../lib/strings";
import { REPO, url } from "../lib/site";
// Linked rather than imported: only two pages carry a diagram, and a plain
// import would put the kit's 47 KB of component rules on all thirty-six others.
import kitHref from "../styles/kit.css?url";
import shellHref from "../styles/app-shell.css?url";

interface Props {
  lang: Lang;
  page: Page;
  pages: Page[];
  idx: number;
  headings: { depth: number; slug: string; text: string }[];
  /** Whether the body embeds a UI-kit diagram, and so needs the kit's styles. */
  hasDiagram?: boolean;
}
const { lang, page, pages, idx, headings, hasDiagram = false } = Astro.props;
const s = stringsFor(lang);
const state = stateOf(page, lang);
const title = titleIn(page, lang);
const prev = idx > 0 ? pages[idx - 1] : null;
const next = idx + 1 < pages.length ? pages[idx + 1] : null;
const category = SECTIONS[page.section][lang];

// Grouped exactly as ORDER runs, so the sidebar mirrors the reading order.
const groups = SECTIONS.map((section, i) => ({
  index: i,
  label: section[lang],
  items: pages.filter((p) => p.section === i),
})).filter((g) => g.items.length > 0);

// "View on GitHub" points at whichever file the reader is actually looking at.
const sourceRel =
  lang === "en" && page.translation ? `${TRANSLATION_DIR}/${page.rel}` : page.rel;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Base
  lang={lang}
  title={`${title} · Tasty`}
  description={`${title} — Tasty ${s.dirDocs}`}
  active="guide"
  enHref={pathOf(page, "en")}
  koHref={pathOf(page, "ko")}
>
  {hasDiagram && (
    <Fragment slot="head">
      <link rel="stylesheet" href={kitHref} />
      <link rel="stylesheet" href={shellHref} />
    </Fragment>
  )}
  <div class="layout">
    <aside class="sidebar" aria-label={s.dirDocs}>
      {groups.map((group) => (
        <details class="nav-section" open data-current={group.index === page.section ? "" : undefined}>
          <summary>{group.label}</summary>
          <ul class="nav-list">
            {group.items.map((item) => (
              <li>
                <a
                  href={url(pathOf(item, lang))}
                  aria-current={item.rel === page.rel ? "page" : undefined}
                  style="--indent:0"
                >{navLabelIn(item, lang)}</a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </aside>

    <main class="content" id="content">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href={url(`${lang === "en" ? "guide" : "ko/guide"}/`)}>{s.dirDocs}</a>
        <span class="sep">/</span>
        <span>{category}</span>
      </nav>

      {state === "untranslated" && (
        <div class="banner banner--info">
          <p>{s.untranslated}</p>
        </div>
      )}
      {state === "stale" && (
        <div class="banner banner--warn">
          <p>{s.stale}</p>
          <a href={url(pathOf(page, "ko"))}>{s.translateCta} →</a>
        </div>
      )}

      <article class="prose"><slot /></article>

      {(prev || next) && (
        <nav class="page-nav">
          {prev && (
            <a class="prev" href={url(pathOf(prev, lang))}>
              <span class="dir">← {s.prev}</span>{navLabelIn(prev, lang)}
            </a>
          )}
          {next && (
            <a class="next" href={url(pathOf(next, lang))}>
              <span class="dir">{s.next} →</span>{navLabelIn(next, lang)}
            </a>
          )}
        </nav>
      )}

      <a class="edit-link" href={`${REPO}/blob/main/site/content/${sourceRel}.md`}>{s.editPage}</a>
    </main>

    <nav class="toc" aria-label={s.tocTitle}>
      {toc.length >= 2 && (
        <>
          <div class="toc__title">{s.tocTitle}</div>
          <ul>
            {toc.map((h) => (
              <li><a class={`lvl-${h.depth}`} href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </>
      )}
    </nav>
  </div>
</Base>
