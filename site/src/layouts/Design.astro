---
/**
 * Design-system page: the section's own sidebar plus a wide main column.
 *
 * Wider than the guide on purpose — what is on these pages is drawn at the
 * size the design system draws it, not reflowed into a prose measure.
 */
import Base from "./Base.astro";
import { DESIGN_NAV, GALLERY_GROUPS, designPath, galleryPath, pick } from "../lib/design";
import { stringsFor } from "../lib/strings";
import { url } from "../lib/site";
import type { Lang } from "../lib/guide";
import "../styles/design.css";

interface Props {
  lang: Lang;
  /** Slug of the page being rendered, so the sidebar can mark it current. */
  current: string;
  title: string;
  intro: string;
}
const { lang, current, title, intro } = Astro.props;
const s = stringsFor(lang);
---
<Base
  lang={lang}
  title={`${title} · Tasty Design System`}
  description={intro}
  active="design"
  enHref={designPath(current, "en")}
  koHref={designPath(current, "ko")}
>
  <div class="layout layout--design">
    <aside class="sidebar" aria-label={s.navDesign}>
      {DESIGN_NAV.map((group) => (
        <details class="nav-section" open>
          <summary>{pick(group.group, lang)}</summary>
          <ul class="nav-list">
            {group.pages.map((page) => (
              <li>
                <a href={url(designPath(page.slug, lang))}
                   aria-current={page.slug === current ? "page" : undefined}
                   style="--indent:0">
                  {pick(page.label, lang)}
                  <span class="nav-desc">{pick(page.desc, lang)}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}

      {/* The gallery is one application published once, not per language, so
          its links are the same on both sides of the site. */}
      <details class="nav-section" open>
        <summary>{lang === "ko" ? "갤러리" : "Gallery"}</summary>
        <ul class="nav-list">
          {GALLERY_GROUPS.flatMap((g) => g.pages).map((page) => (
            <li>
              <a href={url(galleryPath(page.slug))} style="--indent:0">
                {page.label}
                <span class="nav-desc">{page.desc}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    </aside>

    <main class="content content--design" id="content">
      <header class="design-head">
        <p class="design-head__kicker">Tasty Design System</p>
        <h1>{title}</h1>
        <p class="design-head__intro" set:html={intro} />
      </header>
      <slot />
    </main>
  </div>
</Base>
