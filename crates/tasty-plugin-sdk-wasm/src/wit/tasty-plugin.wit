// Tasty plugin WIT (WASI Preview 2 component model) — Phase J.C POC.
//
// 설계 결정 (TODO-C §3.1):
// - JSON-string marshal: ctx/result 타입의 WIT record 변환을 회피하고 모두 string
//   으로 직렬화 (POC 단순화). 비용은 wasm-poc.md §3 에서 측정 후 평가.
//   주의: UiNode/UiEvent DSL 은 C1 에서 native protocol 에서 제거됨 — wasm plugin 의
//   UI 저작 경로는 현재 없다 (user plugin 개방은 1.0 이후, ADR-0028). 아래
//   handle-popup-event / handle-surface-event 시그니처는 POC 잔존물로, native
//   호스트에는 대응 wire 메서드(popup.event / surface.event)가 더 이상 없다.
// - exports = Plugin trait 의 callback 7 종 (init / open-popup / handle-popup-event
//   / on-popup-closed / create-surface / handle-surface-event / handle-ipc-method).
// - imports = host-call (generic IPC), log, tr (i18n lookup).
//   clipboard-history 는 host_port::file 미사용. surface 조작은 host-call 의
//   ui.* 메서드로 통합. → POC imports 3 종.
//
// 본 인터페이스는 POC 전용. production manifest schema (Entry::Wasm) 도입 시
// typed-record 방식으로 재설계 평가 필요.

package tasty:plugin@0.1.0-poc;

interface host {
    /// 호스트 IPC generic call.
    /// method 예: "tool.clipboard.list" / "tool.clipboard.paste" / "ui.popup.update".
    /// params-json: JSON object string. 빈 객체는 "{}".
    /// 반환: Ok(JSON string) | Err(에러 메시지 string).
    host-call: func(method: string, params-json: string) -> result<string, string>;

    /// 구조화 로그. level = "error" | "warn" | "info" | "debug" | "trace".
    log: func(level: string, msg: string);

    /// i18n key lookup. host 가 plugin lang/ 디렉터리를 미리 로드해 보관 (Sub-6.5).
    /// fallback: 매치 없으면 key 자체 반환.
    tr: func(key: string, locale: string) -> string;
}

interface lifecycle {
    /// plugin 시작. locale 은 호스트가 전달 (BCP-47, 예: "ko-KR").
    init: func(plugin-id: string, locale: string);

    /// popup open 요청. ctx-json = PopupOpenCtx 직렬화.
    /// 반환 = PopupOpenResult JSON (현재 빈 객체 "{}" — 콘텐츠는 mesh 채널 전용).
    open-popup: func(ctx-json: string) -> string;

    /// popup 이벤트 처리. ctx-json = PopupEventCtx, 반환 = PopupEventResult.
    handle-popup-event: func(ctx-json: string) -> string;

    /// popup 닫힘 통지. 응답 없음.
    on-popup-closed: func(ctx-json: string);

    /// surface 생성. POC clipboard-history 는 미사용 (no-op 가능).
    create-surface: func(ctx-json: string) -> string;

    /// surface 이벤트 처리. POC clipboard-history 는 미사용.
    handle-surface-event: func(ctx-json: string) -> string;

    /// plugin 자체 IPC namespace 메서드 디스패치.
    /// 반환 = {"ok": Value} | {"err": {"code": string, "message": string}}.
    handle-ipc-method: func(method: string, params-json: string) -> string;
}

world tasty-plugin {
    import host;
    export lifecycle;
}
