// 실험용 WASI Preview 2 플러그인 인터페이스.
// 요청과 결과는 JSON 문자열로 전달한다. 아래 UI 이벤트는 실험용 인터페이스이며
// 현재 네이티브 호스트의 메시지 형식과 다르다.

package tasty:plugin@0.1.0-poc;

interface host {
    /// 호스트 IPC generic call.
    /// method 예: "tool.clipboard.list" / "tool.clipboard.paste" / "ui.popup.update".
    /// params-json: JSON object string. 빈 객체는 "{}".
    /// 반환: Ok(JSON string) | Err(에러 메시지 string).
    host-call: func(method: string, params-json: string) -> result<string, string>;

    /// 구조화 로그. level = "error" | "warn" | "info" | "debug" | "trace".
    log: func(level: string, msg: string);

    /// 번역 키와 언어를 호스트 구현에 전달한다.
    tr: func(key: string, locale: string) -> string;
}

interface lifecycle {
    /// plugin 시작. locale 은 호스트가 전달 (BCP-47, 예: "ko-KR").
    init: func(plugin-id: string, locale: string);

    /// 팝업 열기 요청과 결과를 JSON 문자열로 주고받는다.
    open-popup: func(ctx-json: string) -> string;

    /// popup 이벤트 처리. ctx-json = PopupEventCtx, 반환 = PopupEventResult.
    handle-popup-event: func(ctx-json: string) -> string;

    /// popup 닫힘 통지. 응답 없음.
    on-popup-closed: func(ctx-json: string);

    /// surface 생성. POC clipboard-history 는 미사용 (no-op 가능).
    create-surface: func(ctx-json: string) -> string;

    /// surface 이벤트 처리. POC clipboard-history 는 미사용.
    handle-surface-event: func(ctx-json: string) -> string;

    /// plugin 자체 IPC namespace 메서드 디스패치.
    /// 반환 = {"ok": Value} | {"err": {"code": string, "message": string}}.
    handle-ipc-method: func(method: string, params-json: string) -> string;
}

world tasty-plugin {
    import host;
    export lifecycle;
}
